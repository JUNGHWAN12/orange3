        'Min. number of instances in leaves: ': '잎의 최소 행 수: '
        limit_min_leaf: false
        min_leaf: false
        'Do not split subsets smaller than: ': '이보다 작은 부분집합은 분할하지 않음: '
        limit_min_internal: false
        min_internal: false
        'Limit the maximal tree depth to: ': '최대 트리 깊이 제한: '
        limit_depth: false
        max_depth: false
        'Stop when majority reaches [%]: ': '다수 클래스 비율이 이 값에 도달하면 중지 [%]: '
        limit_majority: false
        sufficient_majority: false
